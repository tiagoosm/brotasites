{
  "name": "brotasites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm test:scripts",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "vitest run --dir scripts",
    "check:launch": "node scripts/check-launch.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
