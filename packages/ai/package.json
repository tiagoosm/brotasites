{
  "name": "@brotasites/ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI layer: providers, art director, copy playbooks and evaluations (docs/ai-and-reviewer.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "playbooks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval": "pnpm run build && node dist/evals/run.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@brotasites/catalog": "workspace:*",
    "@brotasites/engine": "workspace:*",
    "@brotasites/schema": "workspace:*",
    "zod": "4.6.7"
  }
}
