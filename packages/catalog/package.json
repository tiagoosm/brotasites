{
  "name": "@brotasites/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Design catalog for client sites: tokens, families, personalities, ornaments and variants (docs/art-direction.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "specimen": "tsc -p tsconfig.build.json && node scripts/specimen.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@brotasites/schema": "workspace:*"
  }
}
