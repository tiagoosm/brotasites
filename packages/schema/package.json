{
  "name": "@brotasites/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schema and types for the BrotaSites site configuration (single source of truth).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hours": {
      "types": "./dist/hours.d.ts",
      "default": "./dist/hours.js"
    },
    "./v1.2": {
      "types": "./dist/v1.2/index.d.ts",
      "default": "./dist/v1.2/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "json-schema": "tsc -p tsconfig.build.json && node scripts/write-json-schema.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
