---
// The page of the config's version, resolved by the "@site-page" alias (astro.config.ts):
// 1.2 renders the catalog template (src/v12), 1.1 the "classico" template.
import Page from "@site-page";
import { loadAnyConfig } from "../lib/config";

const loaded = loadAnyConfig();

// 1.1 configs: only "classico" exists; the generator rejects other templates before building.
if (loaded.version === "1.1" && loaded.config.design.template !== "classico") {
  throw new Error(`O modelo "${loaded.config.design.template}" ainda não está disponível.`);
}
---

<Page config={loaded.config} />
