---
// Inline icon from the shared set in @brotasites/schema (no icon library in the sites).
// Unknown names fall back to "star".
import { iconSvg } from "@brotasites/schema";

interface Props {
  name: string | null | undefined;
  class?: string;
}

const { name, class: className = "size-6" } = Astro.props;
const svg = iconSvg(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={svg}
/>
