---
import { Image } from "astro:assets";
import type { AboutContent, SiteConfig } from "@brotasites/schema";
import { findImage } from "../../lib/images";
import Section from "./Section.astro";

interface Props {
  config: SiteConfig;
  content: AboutContent;
}

const { config, content } = Astro.props;
const image = findImage(content.image);
// The first paragraph is set large as a lead; the rest reads as body text.
const [lead, ...paragraphs] = content.text.split(/\n+/).filter(Boolean);
---

<Section id="sobre" eyebrow="Sobre" title={content.title}>
  <div class="space-y-12">
    <div class="c-reveal max-w-3xl space-y-5">
      {lead && <p class="c-lead">{lead}</p>}
      {paragraphs.map((paragraph) => <p class="text-lg text-ink-soft">{paragraph}</p>)}
    </div>
    {
      image && (
        <div class="c-reveal-image overflow-hidden rounded-box">
          <Image
            src={image}
            alt={`${content.title} – ${config.business.name}`}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1280px) 820px, (min-width: 1024px) 64vw, 100vw"
            class="c-parallax aspect-[16/10] w-full object-cover"
          />
        </div>
      )
    }
  </div>
</Section>
