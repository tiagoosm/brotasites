---
import type { TestimonialsContent } from "@brotasites/schema";
import Section from "./Section.astro";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;
---

<Section id="depoimentos" eyebrow="Depoimentos" title={content.title}>
  <ul class="c-list border-y border-line">
    {
      content.items.map((item) => (
        <li class="c-reveal py-10">
          <figure>
            <blockquote class="c-lead">
              <span aria-hidden="true" class="block h-8 font-heading text-6xl leading-none text-accent">
                “
              </span>
              <p>{item.text}</p>
            </blockquote>
            <figcaption class="mt-5 text-[0.9375rem]">
              <span class="font-bold">{item.name}</span>
              {item.role && <span class="text-ink-soft"> · {item.role}</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>
