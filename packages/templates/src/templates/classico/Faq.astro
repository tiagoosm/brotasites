---
import type { FaqContent } from "@brotasites/schema";
import Section from "./Section.astro";

interface Props {
  content: FaqContent;
}

const { content } = Astro.props;
---

<Section id="faq" eyebrow="Dúvidas" title={content.title}>
  <div class="c-faq c-list border-y border-line">
    {
      content.items.map((item) => (
        <details class="c-reveal group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-xl font-semibold tracking-tight md:text-2xl [&::-webkit-details-marker]:hidden">
            <span class="font-heading">{item.question}</span>
            <span class="c-plus text-accent" aria-hidden="true" />
          </summary>
          <p class="max-w-2xl pb-7 text-lg text-ink-soft">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
