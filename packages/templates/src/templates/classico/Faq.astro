---
import type { FaqContent } from "@brotasites/schema";
import Section from "./Section.astro";

interface Props {
  content: FaqContent;
  muted: boolean;
}

const { content, muted } = Astro.props;
---

<Section id="faq" title={content.title} muted={muted}>
  <div class="max-w-3xl divide-y divide-ink/15 border-y border-ink/15">
    {content.items.map((item) => (
      <details class="group py-2">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-lg font-bold [&::-webkit-details-marker]:hidden">
          {item.question}
          <span aria-hidden="true" class="text-2xl text-accent transition group-open:rotate-45">+</span>
        </summary>
        <p class="pb-4 leading-relaxed">{item.answer}</p>
      </details>
    ))}
  </div>
</Section>
