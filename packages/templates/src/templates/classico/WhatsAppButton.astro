---
import Icon from "../../components/Icon.astro";
import { whatsappUrl } from "../../lib/links";

interface Props {
  number: string;
}

const { number } = Astro.props;
---

<!-- WhatsApp's dark green keeps the white icon above the 3:1 contrast required for graphics. -->
<a
  href={whatsappUrl(number)}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  class="c-fab c-btn fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full bg-[#128C7E] text-white shadow-[0_12px_28px_-10px_rgb(0_0_0/0.45)] md:right-6 md:bottom-6"
  data-whatsapp-fab
>
  <Icon name="chat" class="size-7" />
</a>
