---
import type { SiteConfig } from "@brotasites/schema";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const { name, contact } = config.business;
const place = [contact.address?.city, contact.address?.state].filter(Boolean).join(" – ");
---

<footer class="mx-auto max-w-7xl px-5 sm:px-8">
  <div
    class="c-rule flex flex-col gap-3 py-10 text-sm text-ink-soft md:flex-row md:items-baseline md:justify-between"
  >
    <p>
      <span class="font-heading text-lg font-semibold text-ink">{name}</span>
      {place && <span> · {place}</span>}
    </p>
    <p>© {new Date().getFullYear()} · Site feito com BrotaSites</p>
  </div>
</footer>
