---
import type { SiteConfig } from "@brotasites/schema";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const { name, contact } = config.business;
const place = [contact.address?.city, contact.address?.state].filter(Boolean).join(" – ");
---

<footer class="border-t border-ink/10 py-10 text-sm">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 md:flex-row md:justify-between">
    <p>© {new Date().getFullYear()} {name}{place && ` · ${place}`}</p>
    <p>Site feito com BrotaSites</p>
  </div>
</footer>
