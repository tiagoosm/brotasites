---
import type { GalleryContent, SiteConfig } from "@brotasites/schema";
import Picture from "../../components/Picture.astro";
import { findImage } from "../../lib/images";
import Section from "./Section.astro";

interface Props {
  config: SiteConfig;
  content: GalleryContent;
}

const { config, content } = Astro.props;
const images = content.images.map(findImage).filter((image) => image !== undefined);
---

{
  images.length > 0 && (
    <Section id="galeria" eyebrow="Galeria" title={content.title} wide>
      <ul
        class="c-gallery -mx-5 px-5 sm:-mx-8 sm:px-8 md:mx-0 md:px-0"
        tabindex="0"
        aria-label={`Fotos de ${config.business.name}`}
      >
        {images.map((image, index) => (
          <li class="c-reveal-image overflow-hidden rounded-box">
            <Picture
              src={image}
              alt={`Foto ${index + 1} de ${images.length} – ${config.business.name}`}
              widths={[360, 640, 960, 1400]}
              sizes="(min-width: 1280px) 720px, (min-width: 768px) 58vw, 82vw"
              class="w-full object-cover"
            />
          </li>
        ))}
      </ul>
    </Section>
  )
}
