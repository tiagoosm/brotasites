---
import type { ContactContent, SiteConfig } from "@brotasites/schema";
import Icon from "../../components/Icon.astro";
import { parseDays } from "../../lib/hours";
import { facebookUrl, instagramUrl, phoneUrl, whatsappUrl } from "../../lib/links";
import Section from "./Section.astro";

interface Props {
  config: SiteConfig;
  content: ContactContent;
}

const { config, content } = Astro.props;
const { contact, social, name } = config.business;
const { address, openingHours } = contact;

const addressLines = address
  ? [
      [address.street, address.district].filter(Boolean).join(" · "),
      [address.city, address.state].filter(Boolean).join(" – "),
      address.zip && `CEP ${address.zip}`,
    ].filter(Boolean)
  : [];
const mapQuery = [name, ...addressLines].join(", ");

const showHours = (content.showHours ?? true) && Boolean(openingHours?.length);
const showMap = Boolean(
  content.showMap && config.integrations?.googleMapsEmbed && addressLines.length,
);
const form = config.integrations?.contactForm;
const showForm = Boolean(content.showForm && form?.provider && form.endpoint);

const formatWhatsapp = (n: string) => n.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, "($1) $2-$3");
const instagramHandle = social?.instagram?.replace(/^@/, "").replace(/^https?:\/\/[^/]+\//, "");

const channels = [
  contact.whatsapp && {
    icon: "chat",
    label: "WhatsApp",
    text: formatWhatsapp(contact.whatsapp),
    href: whatsappUrl(contact.whatsapp),
    external: true,
  },
  contact.phone && {
    icon: "phone",
    label: "Telefone",
    text: contact.phone,
    href: phoneUrl(contact.phone),
    external: false,
  },
  contact.email && {
    icon: "mail",
    label: "E-mail",
    text: contact.email,
    href: `mailto:${contact.email}`,
    external: false,
  },
  social?.instagram && {
    icon: "instagram",
    label: "Instagram",
    text: `@${instagramHandle}`,
    href: instagramUrl(social.instagram),
    external: true,
  },
  social?.facebook && {
    icon: "facebook",
    label: "Facebook",
    text: "Facebook",
    href: facebookUrl(social.facebook),
    external: true,
  },
].filter((channel) => Boolean(channel)) as {
  icon: string;
  label: string;
  text: string;
  href: string;
  external: boolean;
}[];
---

<Section id="contato" eyebrow="Contato" title={content.title}>
  <div class="space-y-14">
    {
      addressLines.length > 0 && (
        <address class="c-reveal c-lead not-italic">
          {addressLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      )
    }

    <div class="grid gap-12 md:grid-cols-2">
      {
        channels.length > 0 && (
          <ul class="c-reveal c-list border-y border-line">
            {channels.map((channel) => (
              <li class="flex items-center gap-4 py-4">
                <Icon name={channel.icon} class="size-5 shrink-0 text-accent" />
                <span class="sr-only">{channel.label}:</span>
                <a
                  href={channel.href}
                  class="c-link c-tabular min-w-0 break-words"
                  {...(channel.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {channel.text}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        showHours && (
          <div class="c-reveal">
            <h3 class="c-eyebrow mb-4">Horário de funcionamento</h3>
            <table class="c-hours c-tabular w-full text-left">
              <tbody>
                {openingHours?.map((row) => {
                  const days = parseDays(row.days);
                  return (
                    <tr
                      class="border-b border-line"
                      data-days={days?.join(",")}
                      data-row-hours={row.hours}
                    >
                      <th scope="row" class="py-3 pr-4 pl-3 font-normal">
                        {row.days}
                        <span
                          class="ml-2 rounded-full bg-brand px-2 py-0.5 text-xs font-bold text-on-brand"
                          data-today-badge
                          hidden
                        >
                          Hoje
                        </span>
                      </th>
                      <td class="py-3 pr-3 text-right">{row.hours}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div class="space-y-14">
      {
        showMap && (
          <div class="c-reveal-image overflow-hidden rounded-box border border-line">
            <iframe
              title={`Mapa com a localização de ${name}`}
              src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="block aspect-[4/3] w-full border-0 md:aspect-[16/9]"
            />
          </div>
        )
      }

      {
        showForm && (
          <form action={form?.endpoint} method="POST" class="c-reveal space-y-5">
            <h3 class="c-eyebrow">Envie uma mensagem</h3>
            <div>
              <label for="contact-name" class="mb-1.5 block text-sm font-bold">
                Nome
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-button border border-line bg-surface px-4 py-3"
              />
            </div>
            <div>
              <label for="contact-email" class="mb-1.5 block text-sm font-bold">
                E-mail
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-button border border-line bg-surface px-4 py-3"
              />
            </div>
            <div>
              <label for="contact-message" class="mb-1.5 block text-sm font-bold">
                Mensagem
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class="w-full rounded-button border border-line bg-surface px-4 py-3"
              />
            </div>
            <button
              type="submit"
              class="c-btn min-h-13 rounded-button bg-brand px-7 font-bold text-on-brand"
            >
              Enviar mensagem
            </button>
          </form>
        )
      }
    </div>
  </div>
</Section>
