---
// Editorial section: the heading stays pinned on the left while the content scrolls by.
// "wide" puts the heading above full-width content (used by the gallery).

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  wide?: boolean;
}

const { id, eyebrow, title, wide = false } = Astro.props;
// Skip the eyebrow when the client's title already says the same thing ("Galeria").
const showEyebrow = eyebrow.toLocaleLowerCase("pt-BR") !== title.trim().toLocaleLowerCase("pt-BR");
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-16">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div
      class:list={[
        "c-rule grid gap-x-12 gap-y-10 py-20 md:py-28",
        !wide && "lg:grid-cols-12",
      ]}
    >
      <header class:list={["c-reveal self-start", !wide && "lg:sticky lg:top-28 lg:col-span-4"]}>
        {showEyebrow && <p class="c-eyebrow mb-4">{eyebrow}</p>}
        <h2 id={`${id}-title`} class="c-display-l">{title}</h2>
      </header>
      <div class:list={[!wide && "lg:col-span-8"]}>
        <slot />
      </div>
    </div>
  </div>
</section>
