---
import type { SiteConfig } from "@brotasites/schema";
import Layout from "../../components/Layout.astro";
import { buildWeek, parseOpeningHours, timeZoneForState } from "../../lib/hours";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Faq from "./Faq.astro";
import FinalCta from "./FinalCta.astro";
import Footer from "./Footer.astro";
import Gallery from "./Gallery.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Testimonials from "./Testimonials.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import "./classico.css";

interface Props {
  config: SiteConfig;
  /** Rendered by the live preview server instead of a static build. */
  preview?: boolean;
}

const { config, preview = false } = Astro.props;
const { contact } = config.business;
// Sections render in the order chosen by the client; disabled ones are skipped.
const sections = config.sections.filter((section) => section.enabled);
const whatsapp = config.integrations?.whatsappFloatingButton ? contact.whatsapp : undefined;

// The weekly schedule is computed at build time; the browser only checks the clock.
const parsedHours = parseOpeningHours(contact.openingHours);
const week = parsedHours ? buildWeek(parsedHours) : undefined;
---

<Layout config={config} preview={preview}>
  <slot name="head" slot="head" />
  <a
    href="#inicio"
    class="sr-only z-50 rounded-button bg-brand px-4 py-2 font-bold text-on-brand focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >
    Pular para o conteúdo
  </a>
  <Header config={config} />
  <main id="inicio">
    {
      !sections.some((section) => section.id === "hero") && (
        <h1 class="sr-only">{config.business.name}</h1>
      )
    }
    {
      sections.map((section) => {
        switch (section.id) {
          case "hero":
            return <Hero config={config} content={section.content} hasSchedule={Boolean(week)} />;
          case "sobre":
            return <About config={config} content={section.content} />;
          case "servicos":
            return <Services content={section.content} />;
          case "galeria":
            return <Gallery config={config} content={section.content} />;
          case "depoimentos":
            return <Testimonials content={section.content} />;
          case "faq":
            return <Faq content={section.content} />;
          case "cta-final":
            return <FinalCta config={config} content={section.content} />;
          case "contato":
            return <Contact config={config} content={section.content} />;
        }
      })
    }
  </main>
  <Footer config={config} />
  {whatsapp && <WhatsAppButton number={whatsapp} />}
  <div
    hidden
    data-schedule
    data-week={JSON.stringify(week ?? [])}
    data-tz={timeZoneForState(contact.address?.state)}
  >
  </div>
</Layout>

<script>
  import "./hours-client";
</script>
