---
import { Image } from "astro:assets";
import type { HeroContent, SiteConfig } from "@brotasites/schema";
import Button from "../../components/Button.astro";
import { findImage } from "../../lib/images";
import { ctaLink } from "../../lib/links";

interface Props {
  config: SiteConfig;
  content: HeroContent;
}

const { config, content } = Astro.props;
const image = findImage(content.image);
---

<section id="hero" aria-labelledby="hero-title" class="scroll-mt-20">
  <div
    class:list={[
      "mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:py-24",
      image && "md:grid-cols-2",
    ]}
  >
    <div class:list={[!image && "mx-auto max-w-3xl text-center"]}>
      {config.business.tagline && config.business.tagline !== content.title && (
        <p class="mb-3 text-sm font-bold tracking-wide text-accent uppercase">{config.business.tagline}</p>
      )}
      <h1 id="hero-title" class="text-4xl leading-tight font-bold md:text-6xl">{content.title}</h1>
      {content.subtitle && <p class="mt-5 text-lg md:text-xl">{content.subtitle}</p>}
      {content.cta && (
        <div class="mt-8">
          <Button link={ctaLink(content.cta, config)} config={config}>{content.cta.label}</Button>
        </div>
      )}
    </div>
    {image && (
      <Image
        src={image}
        alt={`Foto de ${config.business.name}`}
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        priority
        class="aspect-[4/3] w-full rounded-box object-cover shadow-xl"
      />
    )}
  </div>
</section>
