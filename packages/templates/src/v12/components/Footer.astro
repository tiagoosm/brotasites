---
import type { Personality } from "@brotasites/catalog";
import type { SiteConfig } from "@brotasites/schema/v1.2";
import { facebookHref, instagramHref } from "../lib/links";
import Mark from "./Mark.astro";

interface Props {
  config: SiteConfig;
  markStyle: string;
  personality: Personality;
}

const { config, markStyle, personality } = Astro.props;
const { business, brand } = config;
const year = new Date().getFullYear();
// The name huge and cut off at the bottom: a signature of the bolder personalities.
const giantName =
  personality === "moderno" || personality === "ousado" || personality === "robusto";
---

<footer class="site-footer tone-inverse">
  <div class="container footer-grid">
    <Mark name={business.name} style={markStyle} logoAsset={brand.logoAsset} size="large" />
    <div class="footer-meta">
      {
        business.registration && (
          <p>
            Registro profissional: {business.registration.council} {business.registration.number}
          </p>
        )
      }
      {
        (business.social.instagram || business.social.facebook) && (
          <ul class="footer-social">
            {business.social.instagram && (
              <li>
                <a href={instagramHref(business.social.instagram)} target="_blank" rel="noopener noreferrer">
                  Instagram
                </a>
              </li>
            )}
            {business.social.facebook && (
              <li>
                <a href={facebookHref(business.social.facebook)} target="_blank" rel="noopener noreferrer">
                  Facebook
                </a>
              </li>
            )}
          </ul>
        )
      }
      <p class="footer-copy">© {year} {business.name}</p>
    </div>
  </div>
  {giantName && <p class="footer-giant" aria-hidden="true">{business.name}</p>}
</footer>
