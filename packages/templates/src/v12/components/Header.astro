---
import type { SiteConfig } from "@brotasites/schema/v1.2";
import { primaryContact } from "../lib/links";
import Button from "./Button.astro";
import Mark from "./Mark.astro";

interface Props {
  config: SiteConfig;
  markStyle: string;
}

const { config, markStyle } = Astro.props;
const { business, navigation, brand } = config;
---

<header class:list={["site-header", "tone-base", navigation.sticky && "is-sticky"]}>
  <div class="container header-row">
    <a href="#inicio" class="header-home" aria-label={`${business.name}, início`}>
      <Mark name={business.name} style={markStyle} logoAsset={brand.logoAsset} />
    </a>
    <Button link={primaryContact(business)} label={navigation.ctaLabel} class="header-cta" />
  </div>
</header>
