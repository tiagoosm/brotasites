---
// sobre-split: the story as a short manifesto that lights up word by word, next to a photo
// (or an ornament when there is none).
import Ornament from "../components/Ornament.astro";
import Photo from "../components/Photo.astro";
import SectionShell from "../components/SectionShell.astro";
import Words from "../components/Words.astro";
import { findAsset } from "../lib/assets";
import type { VariantProps } from "./types";

type Props = VariantProps<"sobre">;
const { config, theme, content, tone, previousTone, divider, index } = Astro.props;
const image = findAsset(content.image?.assetId);
---

<SectionShell id="sobre" title={content.title} tone={tone} previousTone={previousTone} divider={divider} label="Nossa história">
  <div class:list={["sobre-grid", !image && "no-photo"]}>
    <Words text={content.text} anim="words-lit" class="sobre-text" />
    {
      image ? (
        <div data-anim="reveal">
          <Photo image={image} alt={content.image?.alt ?? ""} treatment={theme.identity.imageTreatment} sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
      ) : (
        <span class="sobre-ornament" data-anim="float">
          <Ornament set={theme.identity.ornamentSet} index={index + 1} seed={config.design.seed} />
        </span>
      )
    }
  </div>
</SectionShell>

<style>
  .sobre-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .sobre-grid {
      grid-template-columns: 1.2fr 1fr;
    }
    .sobre-grid.no-photo {
      grid-template-columns: 1fr auto;
    }
  }
  :global(.sobre-text) {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.3;
    margin: 0;
    max-width: 34ch;
  }
  .sobre-ornament {
    display: block;
    width: clamp(6rem, 18vw, 12rem);
    color: var(--ornament);
  }
  .sobre-ornament :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
