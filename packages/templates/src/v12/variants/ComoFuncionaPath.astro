---
import SectionShell from "../components/SectionShell.astro";
import type { VariantProps } from "./types";

// como-funciona-path: the steps zigzag down a dotted path, like a route on a map.

type Props = VariantProps<"como-funciona">;
const { content, tone, previousTone, divider } = Astro.props;
---

<SectionShell id="como-funciona" title={content.title} tone={tone} previousTone={previousTone} divider={divider} label="Como funciona">
  <ol class="path" data-anim="stagger">
    {
      content.steps.map((step, index) => (
        <li class:list={["path-step", index % 2 === 1 && "is-right"]}>
          <span class="path-dot" aria-hidden="true">{index + 1}</span>
          <div>
            <h3 class="path-title">{step.title}</h3>
            <p class="path-text">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</SectionShell>

<style>
  .path {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 3px dotted color-mix(in oklab, var(--fg) 50%, transparent);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 48rem;
  }
  .path-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-left: -2.85rem;
  }
  @media (min-width: 900px) {
    .path-step.is-right {
      margin-left: 6rem;
    }
  }
  .path-dot {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--button-bg);
    color: var(--button-fg);
    font-weight: 700;
  }
  .path-title {
    font-size: var(--step-1);
    margin: 0.35rem 0 0.25rem;
  }
  .path-text {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
