---
// depoimentos-cards: real, authorized testimonials only (the schema refuses any other).
import SectionShell from "../components/SectionShell.astro";
import type { VariantProps } from "./types";

type Props = VariantProps<"depoimentos">;
const { content, tone, previousTone, divider } = Astro.props;
---

<SectionShell id="depoimentos" title={content.title} tone={tone} previousTone={previousTone} divider={divider} label="Quem já veio">
  <ul class="quotes" data-anim="stagger">
    {
      content.items.map((item) => (
        <li class="quote">
          <blockquote>
            <p>{item.text}</p>
          </blockquote>
          <p class="quote-author">
            {item.name}
            {item.context && <span class="quote-context">, {item.context}</span>}
          </p>
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .quote {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  blockquote {
    margin: 0;
    font-size: var(--step-1);
    font-family: var(--font-heading);
    line-height: 1.35;
  }
  blockquote p {
    margin: 0;
  }
  blockquote p::before {
    content: "“";
  }
  blockquote p::after {
    content: "”";
  }
  .quote-author {
    margin: 1rem 0 0;
    font-weight: 700;
  }
  .quote-context {
    font-weight: 400;
    color: var(--fg-muted);
  }
</style>
