---
// galeria-mosaic: the client's photos in a mosaic; the first one spans two rows.
import Photo from "../components/Photo.astro";
import SectionShell from "../components/SectionShell.astro";
import { findAsset } from "../lib/assets";
import type { VariantProps } from "./types";

type Props = VariantProps<"galeria">;
const { content, tone, previousTone, divider } = Astro.props;
const photos = content.images.flatMap((image) => {
  const file = findAsset(image.assetId);
  return file ? [{ file, alt: image.alt }] : [];
});
---

{
  photos.length > 0 && (
    <SectionShell id="galeria" title={content.title} tone={tone} previousTone={previousTone} divider={divider} label="Fotos" wide>
      <ul class="mosaic" data-anim="stagger">
        {photos.map((photo, index) => (
          <li class:list={["tile", index === 0 && photos.length > 2 && "tile-big"]}>
            <Photo image={photo.file} alt={photo.alt} treatment="none" sizes="(min-width: 900px) 33vw, 100vw" />
          </li>
        ))}
      </ul>
    </SectionShell>
  )
}

<style>
  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    grid-auto-rows: 15rem;
  }
  .tile :global(.photo),
  .tile :global(picture),
  .tile :global(img) {
    height: 100%;
    width: 100%;
  }
  .tile :global(img) {
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .tile-big {
      grid-row: span 2;
    }
  }
</style>
