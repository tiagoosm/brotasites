---
// diferenciais-grid: a grid of line icons with short reasons to choose the business.
import Icon from "../../components/Icon.astro";
import SectionShell from "../components/SectionShell.astro";
import type { VariantProps } from "./types";

type Props = VariantProps<"diferenciais">;
const { content, tone, previousTone, divider } = Astro.props;
---

<SectionShell id="diferenciais" title={content.title} tone={tone} previousTone={previousTone} divider={divider} label="Por que a gente">
  <ul class="grid" data-anim="stagger">
    {
      content.items.map((item) => (
        <li class="item">
          <span class="badge">
            <Icon name={item.icon} class="badge-icon" />
          </span>
          <h3 class="item-title">{item.title}</h3>
          {item.text && <p class="item-text">{item.text}</p>}
        </li>
      ))
    }
  </ul>
</SectionShell>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .badge {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background: var(--button-bg);
    color: var(--button-fg);
  }
  :global(.badge-icon) {
    width: 1.75rem;
    height: 1.75rem;
  }
  .item-title {
    font-size: var(--step-1);
    margin: 1rem 0 0.25rem;
  }
  .item-text {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
