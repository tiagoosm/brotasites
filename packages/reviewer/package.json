{
  "name": "@brotasites/reviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Site reviewer: deterministic checks and the reviewer agent (docs/ai-and-reviewer.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calibration": {
      "types": "./dist/calibration.d.ts",
      "default": "./dist/calibration.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "calibrate": "vitest run --config vitest.e2e.config.ts test/e2e/calibration.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@brotasites/ai": "workspace:*",
    "@brotasites/catalog": "workspace:*",
    "@brotasites/engine": "workspace:*",
    "@brotasites/generator": "workspace:*",
    "@brotasites/schema": "workspace:*",
    "@brotasites/templates": "workspace:*",
    "@playwright/test": "1.64.1",
    "zod": "4.6.7"
  }
}
