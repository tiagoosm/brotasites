# Copy this file to .env.local and fill in the values.
# Never commit real secrets.

# Supabase (database, magic-link auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI layer (packages/ai, docs/ai-and-reviewer.md).
# simulated: no API call (tests, development, CI). live: Claude through the Anthropic API.
AI_MODE=simulated
# The model always comes from here, never from the code. Decision of E8: claude-opus-5-5
# (docs/owner-steps.md, Decisions to review). Prices are checked in packages/ai/src/prices.ts.
AI_MODEL_ID=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Secret: only in .env.local and in the hosting's environment variables.
ANTHROPIC_API_KEY=
# Limits: AI rounds per site and per account per day, global budget per day (USD) and the
# share of it that raises the alert.
AI_ROUNDS_PER_SITE_PER_DAY=20
AI_ROUNDS_PER_ACCOUNT_PER_DAY=40
AI_DAILY_BUDGET_USD=20
AI_BUDGET_ALERT_RATIO=0.8

# Cloudflare (client sites: one R2 bucket served by apps/sites-worker)
CLOUDFLARE_ACCOUNT_ID=
# Used by Wrangler to deploy apps/sites-worker
CLOUDFLARE_API_TOKEN=
# R2 API token (Object Read & Write on the bucket), used by the generation worker
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brotasites-sites

# Public address of the platform (canonical links, sitemap, share image)
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Finished sites before publishing: private previews at <origin>/<site id>/<token>/
# (previa.<BASE_DOMAIN> in production, served by apps/sites-worker; the local runner of
# apps/jobs serves them at http://127.0.0.1:4500 in development).
NEXT_PUBLIC_PREVIEW_ORIGIN=http://127.0.0.1:4500
LOCAL_PREVIEWS_DIR=.previews
LOCAL_PREVIEWS_PORT=4500

# Base domain of 1.2 client sites, separate from the platform's (docs/hosting.md).
# Undecided: sites.localhost in development. The platform shows it in the address step.
BASE_DOMAIN=sites.localhost
NEXT_PUBLIC_BASE_DOMAIN=sites.localhost

# Job queue: Trigger.dev (decision of E10, docs/owner-steps.md). The platform triggers the
# "site-job" task with this secret key (server only); without it jobs wait for the local
# runner: pnpm --filter @brotasites/jobs dev:local
TRIGGER_SECRET_KEY=
# Project of apps/jobs on Trigger.dev, used by `trigger deploy`.
TRIGGER_PROJECT_REF=
# true: finished sites skip the human review queue and go straight to the client
# (development only; at first every site goes through a person, CLAUDE.md).
REVIEW_SKIP_HUMAN=false

# Payments: stub (a test screen confirms the payment, nothing is charged) until Asaas is in.
# Empty turns approval off. Never "stub" in production.
PAYMENTS_MODE=stub

# Restricted code layer: the AI proposing new variants as code (docs/catalog-promotion.md).
# Off until the blind test shows a real gain.
AI_CODE_VARIANTS=false
