# Copy this file to .env.local and fill in the values.
# Never commit real secrets.
# Production: docs/launch-status.md lists where each variable goes (Vercel, Trigger.dev, the
# Worker); `pnpm check:launch --target vercel --env <file>` says what is missing, without values.
# LOCAL_PREVIEWS_* are for the local runner only; TRIGGER_PROJECT_REF only for `trigger deploy`.

# Supabase (database, auth: email and password, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# "true" once IP address forwarding is on in Supabase (Authentication > Rate Limits): the
# account routes then pass the visitor's IP, so Supabase's per-IP limits count each visitor.
SUPABASE_FORWARD_IP=

# Vercel Cron's bearer token for /api/cron/keep-alive (daily read-only queries so Supabase
# does not pause the Free plan project). Any long random string; set in Vercel, server only.
CRON_SECRET=

# Bot protection on sign-up, sign-in and "esqueci a senha": Cloudflare Turnstile through
# Supabase Auth's CAPTCHA protection (the secret key goes only in the Supabase dashboard).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# "simulated" in development and tests only (no widget, no token). Refused in production.
# "off": testing the deployed platform before launch, without Turnstile. Remove before launch.
NEXT_PUBLIC_CAPTCHA_MODE=simulated

# AI layer (packages/ai, docs/ai-and-reviewer.md).
# simulated: no API call (tests, development, CI). live: Claude through the Anthropic API.
AI_MODE=simulated
# The model always comes from here, never from the code. Decision of E8: claude-opus-5-5
# (docs/owner-steps.md, Decisions to review). Prices are checked in packages/ai/src/prices.ts.
AI_MODEL_ID=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Secret: only in .env.local and in the hosting's environment variables.
ANTHROPIC_API_KEY=
# Limits: AI rounds per site and per account per day, global budget per day (USD) and the
# share of it that raises the alert.
AI_ROUNDS_PER_SITE_PER_DAY=20
AI_ROUNDS_PER_ACCOUNT_PER_DAY=40
AI_DAILY_BUDGET_USD=20
AI_BUDGET_ALERT_RATIO=0.8

# Cloudflare (client sites: one R2 bucket served by apps/sites-worker)
CLOUDFLARE_ACCOUNT_ID=
# Used by Wrangler to deploy apps/sites-worker
CLOUDFLARE_API_TOKEN=
# R2 API token (Object Read & Write on the bucket), used by the generation worker
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brotasites-sites
# Workers KV of the sites Worker (site pointers and states, custom domains, preview tokens).
# The API token may only edit this namespace (Account > Workers KV Storage > Edit). Used by the
# jobs (publishing, previews) and by the platform (suspensions).
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=
# Signs the links to download a site's .zip. The same value goes to the Worker as a secret, set
# once in the Cloudflare dashboard (docs/owner-steps.md, E35). Server only.
EXPORT_SECRET=

# Addresses (E28): every one is read in apps/platform/src/lib/domains/hosts.ts, never written by
# hand elsewhere. The rule (docs/security.md): the platform and the client sites always on
# different registrable domains. Production: brotasites.com.br (platform) and brotasites.com
# (sites). A production build on Vercel refuses to run with these missing or on one domain.
# The platform's public address (canonical links, sitemap, share image, links in emails).
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
# The team's area on its own host (production: admin.brotasites.com.br). Empty: /admin stays on
# the platform's address, as in development and tests.
NEXT_PUBLIC_ADMIN_HOST=
# Contact addresses shown on the site (footer, Ajuda, Termos, Privacidade, abuse reports).
# Empty: contato@, privacidade@ and abuso@ the platform's host (none on localhost).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_ABUSE_EMAIL=

# Finished sites before publishing: private previews at <origin>/<site id>/<token>/
# (https://previa.brotasites.com in production, served by apps/sites-worker; the local runner
# of apps/jobs serves them at http://127.0.0.1:4500 in development).
NEXT_PUBLIC_PREVIEW_ORIGIN=http://127.0.0.1:4500
LOCAL_PREVIEWS_DIR=.previews
LOCAL_PREVIEWS_PORT=4500

# Base domain of the client sites, separate from the platform's (docs/hosting.md).
# Production: brotasites.com. sites.localhost in development. BASE_DOMAIN is read by the jobs
# and the templates, NEXT_PUBLIC_BASE_DOMAIN by the platform: keep them equal.
BASE_DOMAIN=sites.localhost
NEXT_PUBLIC_BASE_DOMAIN=sites.localhost

# Job queue: Trigger.dev (decision of E10, docs/owner-steps.md). The platform triggers the
# "site-job" task with this secret key (server only); without it jobs wait for the local
# runner: pnpm --filter @brotasites/jobs dev:local
TRIGGER_SECRET_KEY=
# Project of apps/jobs on Trigger.dev, used by `trigger deploy`.
TRIGGER_PROJECT_REF=

# The client's own domain (E25), included in the price and optional. "simulated": a stand-in for
# the hosting, development and tests only (never in production). "cloudflare": Cloudflare for
# SaaS on the BASE_DOMAIN zone (docs/owner-steps.md, "Client domains"). Empty: the flow is off
# and the site's page says it is coming soon.
DOMAINS_MODE=simulated
# Cloudflare for SaaS (server only): the zone of BASE_DOMAIN and a token that may only edit its
# custom hostnames ("SSL and Certificates: Edit" on that zone; to verify when creating it).
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_API_TOKEN=
# The name clients point their CNAME to (default: clientes.<BASE_DOMAIN>).
CUSTOM_DOMAIN_TARGET=
# true: finished sites skip the human review queue and go straight to the client
# (development only; at first every site goes through a person, CLAUDE.md).
REVIEW_SKIP_HUMAN=false

# Payments: stub (a test screen confirms the payment, nothing is charged) until Asaas is in.
# Empty turns approval off. Never "stub" in production.
PAYMENTS_MODE=stub

# Restricted code layer: the AI proposing new variants as code (docs/catalog-promotion.md).
# Off until the blind test shows a real gain.
AI_CODE_VARIANTS=false
