# Copy this file to .env.local and fill in the values.
# Never commit real secrets.

# Supabase (database, magic-link auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (AI copy suggestions)
ANTHROPIC_API_KEY=

# Cloudflare (client sites: one R2 bucket served by apps/sites-worker)
CLOUDFLARE_ACCOUNT_ID=
# Used by Wrangler to deploy apps/sites-worker
CLOUDFLARE_API_TOKEN=
# R2 API token (Object Read & Write on the bucket), used by the generation worker
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brotasites-sites

# Public address of the platform (canonical links, sitemap, share image)
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# Live preview server (apps/preview)
NEXT_PUBLIC_PREVIEW_URL=http://localhost:4400
# Origins allowed to embed the preview (CSP frame-ancestors), space separated
PREVIEW_FRAME_ANCESTORS='self' http://localhost:3000

# Domain where published sites live (subdomain.<domain>).
NEXT_PUBLIC_SITES_DOMAIN=brotasites.com
# Until the domain exists: the sites Worker address, where sites open by path
# (https://brotasites-sites.<account>.workers.dev/<subdomain>/). Empty in production.
NEXT_PUBLIC_SITES_TEST_URL=

# Base domain of 1.2 client sites, separate from the platform's (docs/hosting.md).
# Undecided: sites.localhost in development.
BASE_DOMAIN=sites.localhost

# Restricted code layer: the AI proposing new variants as code (docs/catalog-promotion.md).
# Off until the blind test shows a real gain.
AI_CODE_VARIANTS=false
