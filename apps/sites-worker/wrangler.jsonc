// The single Worker that serves every client site (docs/hosting.md). Nothing here is deployed
// by the platform or by Claude Code: the owner publishes it from GitHub (docs/owner-steps.md).
//
// The values below are production's (E34): sites on brotasites.com, the platform on
// brotasites.com.br. Locally, `pnpm --filter @brotasites/sites-worker dev` runs a copy without the
// routes (dev/local-config.ts) in Miniflare, with sites.localhost, localhost:3000 and local R2/KV.
//
// Order of the owner's steps (docs/owner-steps.md, E35; nothing is deployed from a laptop):
//   1. Secrets in GitHub's `production` environment (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID);
//      `pnpm check:launch --target github` lists them.
//   2. DNS in the brotasites.com zone: proxied `*` and root records to a reserved address
//      (192.0.2.1), so requests reach the routes below.
//   3. GitHub > Actions > "Deploy Worker" > Run workflow on main, typing "publicar". It runs
//      `wrangler deploy`, which uploads the Worker and sets the routes below.
//   4. EXPORT_SECRET once, in the Cloudflare dashboard (Workers & Pages > brotasites-sites >
//      Settings > Variables and Secrets, type Secret), the same value as the platform's. Never
//      in a workflow; later deploys keep it.
// The account and KV ids below are identifiers, not secrets (the API token is the secret).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brotasites-sites",
  "main": "src/index.ts",
  "account_id": "fe5c7c59048cdbc3bccc2e1da2315135",
  "compatibility_date": "2026-10-01",
  // Only the routes below, never <name>.<subdomain>.workers.dev (E35c). With true, wrangler deploy
  // needs the account's workers.dev subdomain and, unattended on GitHub, stopped asking to
  // register one. The account's subdomain is shared with its other Workers and must not change.
  "workers_dev": false,
  // No per-version preview URLs either (they also live on workers.dev).
  "preview_urls": false,
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "brotasites-sites" }],
  // Site pointers and states, custom domains and preview tokens: the brotasites-hosting namespace.
  "kv_namespaces": [{ "binding": "HOSTING", "id": "73cce7141d614ffdb33f7ed100510900" }],
  // The client sites' own domain, separate from the platform's, and the platform's address (the
  // bare sites domain and its www redirect there, E28).
  "vars": { "BASE_DOMAIN": "brotasites.com", "PLATFORM_URL": "https://brotasites.com.br" },
  // One route for every subdomain, so the zone's route limits never grow with clients, and one
  // for the bare domain (it redirects to the platform). wrangler only needs the zone to exist to
  // set them; requests reach them once the proxied DNS records of step 3 exist.
  "routes": [
    { "pattern": "*.brotasites.com/*", "zone_name": "brotasites.com" },
    { "pattern": "brotasites.com/*", "zone_name": "brotasites.com" }
  ],
  "observability": { "enabled": true }
}
