---
import ClassicoPage from "@brotasites/templates/classico";
import example from "../../../../docs/site-config.example.json";
import { frameAncestors, readPreviewRequest } from "../lib/preview";

export const prerender = false;

const request = await readPreviewRequest(Astro.request, example);
if (!request.ok) {
  return new Response(request.message, {
    status: request.status,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}

Astro.response.headers.set("Content-Security-Policy", `frame-ancestors ${frameAncestors()}`);
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { config, scroll, animate } = request;
---

<ClassicoPage config={config} preview>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    {
      !animate && (
        <style is:inline>
          {`.c-rise,.c-word>span,.c-window,.c-window__img,.c-sign[data-state],.c-fab{animation:none!important}`}
        </style>
      )
    }
    <script is:inline define:vars={{ scroll }}>
      // Preview runtime: restore the reading position across refreshes, tell the form where
      // the visitor is, and keep every click inside the preview.
      history.scrollRestoration = "manual";
      document.documentElement.style.scrollBehavior = "auto";
      document.addEventListener("DOMContentLoaded", () => window.scrollTo(0, scroll));

      let queued = false;
      window.addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            window.parent.postMessage({ type: "brotasites:preview-scroll", y: window.scrollY }, "*");
          });
        },
        { passive: true },
      );

      document.addEventListener(
        "click",
        (event) => {
          const link = event.target instanceof Element ? event.target.closest("a") : null;
          if (link && !(link.getAttribute("href") ?? "").startsWith("#")) event.preventDefault();
        },
        true,
      );
    </script>
  </Fragment>
</ClassicoPage>
